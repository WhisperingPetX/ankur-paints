# ============================================================================
# Ankur Paints Digital Operations Platform — Root Environment Template
# Copy this file to mobile/.env and web/.env with your respective keys.
# DO NOT COMMIT REAL PRODUCTION KEYS TO VERSION CONTROL.
# ============================================================================

# Supabase Project Configuration (South Asia - Mumbai region recommended)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Web (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
